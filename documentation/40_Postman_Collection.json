  "item": [
    {
      "name": "Auth",
      "description": "Authentication and registration endpoints",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Mehta\",\n  \"email\": \"arjun@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "description": "Create a new user account. After registration, create a workspace via POST /api/organizations."
          },
          "response": []
        },
        {
          "name": "Login (NextAuth Credentials)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "callback", "credentials"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "arjun@example.com" },
                { "key": "password", "value": "securepassword123" },
                { "key": "csrfToken", "value": "{{csrfToken}}" },
                { "key": "callbackUrl", "value": "{{baseUrl}}/dashboard" },
                { "key": "json", "value": "true" }
              ]
            },
            "description": "NextAuth credentials login. Requires CSRF token. Use the browser flow for easier testing."
          },
          "response": []
        },
        {
          "name": "Get CSRF Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            },
            "description": "Get CSRF token required for login form submission."
          },
          "response": []
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            },
            "description": "Get the current session. Returns user data if authenticated."
          },
          "response": []
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signout"]
            },
            "description": "Sign out the current user and invalidate the session."
          },
          "response": []
        }
      ]
    },
