# ── Database ──────────────────────────────────────────────────────────────────
# For local dev (SQLite):
# DATABASE_URL="file:./dev.db"
# For production (PostgreSQL — get free DB from https://neon.tech):
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://yourdomain.com"

# ── AI (NVIDIA NIM — OpenAI-compatible) ─────────────────────────────────────────
NVIDIA_API_KEY="nvapi-..."
NVIDIA_MODEL="nvidia/nemotron-3-super-120b-a12b"
NVIDIA_FAST_MODEL="nvidia/nemotron-3-super-120b-a12b"

# ── Demo mode (optional) ─────────────────────────────────────────────────────────
# Comma-separated organization IDs that bypass all plan limits, feature gates,
# and AI credit consumption — use for a publicly shared demo workspace.
DEMO_ORG_IDS=""

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="ZYNOTRIX"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ── Integrations (all optional) ───────────────────────────────────────────────
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
GITHUB_WEBHOOK_SECRET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""
